# Local development can bind all interfaces. On a single VPS behind Nginx,
# set HOST=127.0.0.1 so Strapi is not directly reachable from the internet.
HOST=0.0.0.0
PORT=1337
# Public CMS origin and reverse-proxy setting. Leave unset/false locally.
# PUBLIC_URL=https://cms.example.com
# IS_PROXIED=true
# Comma-separated browser origins. The Next reader is server-to-server and
# does not need CORS, so only add origins that genuinely need browser access.
# CORS_ORIGINS=https://www.example.com,https://example.com
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# PostgreSQL is required for both local and deployed CMS environments. Replace
# the placeholders locally; do not reuse production credentials. The retained
# cms/.tmp/data.db file is an offline rollback source, not a runtime database.
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://<local-user>:<url-encoded-password>@127.0.0.1:5432/jr_compliance_cms_local
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# Current content is moved through reviewed encrypted Strapi content/files
# exports. Keep every legacy seed/backfill flag disabled in PostgreSQL.
SEED_DEMO_CONTENT=false
SEED_COMPANY_REGISTRATION_PAGES=false
SEED_MCA_SERVICE_PAGES=false
SEED_LEAD_FORM_SETTINGS=false

# Signed publish notifications to the Next.js cache-revalidation route. Leave
# both unset until the frontend is deployed. On a shared VPS, use
# http://127.0.0.1:8123/api/revalidate to keep this request off the public edge.
NEXT_REVALIDATE_URL=
STRAPI_REVALIDATE_SECRET=
