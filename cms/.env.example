# Local development can bind all interfaces. On a single VPS behind Nginx,
# set HOST=127.0.0.1 so Strapi is not directly reachable from the internet.
HOST=0.0.0.0
PORT=1337
# Public CMS origin and reverse-proxy setting. Leave unset/false locally.
# PUBLIC_URL=https://cms.example.com
# IS_PROXIED=true
# Comma-separated browser origins. The Next reader is server-to-server and
# does not need CORS, so only add origins that genuinely need browser access.
# CORS_ORIGINS=https://www.example.com,https://example.com
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# SQLite is for local development only. Use PostgreSQL and production secrets
# for deployed environments; see config/database.ts for the supported values.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/jr_compliance
# DATABASE_SSL=false
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=10

# Explicitly opt in to the one-time local content/media seed. It reads approved
# files from ../frontend/public/images and never runs in production by default.
SEED_DEMO_CONTENT=true
# One-time local backfill for an existing CMS. It creates only missing approved
# Company Registration slugs and never overwrites an editor's record.
SEED_COMPANY_REGISTRATION_PAGES=true
# One-time local backfill for an existing CMS. It creates only the missing
# approved MCA Services DSC record and never overwrites an editor's record.
SEED_MCA_SERVICE_PAGES=true
# One-time local backfill for an existing CMS. It adds approved Lead Form
# settings only when a published Site Setting has none, without overwriting
# editor content or publishing pending draft changes.
SEED_LEAD_FORM_SETTINGS=true

# Signed publish notifications to the Next.js cache-revalidation route. Leave
# both unset until the frontend is deployed. On a shared VPS, use
# http://127.0.0.1:8123/api/revalidate to keep this request off the public edge.
NEXT_REVALIDATE_URL=
STRAPI_REVALIDATE_SECRET=
