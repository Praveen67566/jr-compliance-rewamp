{
  "collectionName": "components_navigation_menu_items",
  "info": {
    "displayName": "Menu item",
    "description": "A top-level header item with either mega-menu categories, simple child links, or a direct href."
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "string"
    },
    "children": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "categories": {
      "type": "component",
      "component": "navigation.menu-category",
      "repeatable": true
    }
  }
}
