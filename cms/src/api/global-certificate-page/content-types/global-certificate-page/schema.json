{
  "kind": "collectionType",
  "collectionName": "global_certificate_pages",
  "info": {
    "singularName": "global-certificate-page",
    "pluralName": "global-certificate-pages",
    "displayName": "Global Certificate Page",
    "description": "A fixed, CMS-managed country certificate detail page."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "menuLabel": {
      "type": "string",
      "required": true
    },
    "countryName": {
      "type": "string",
      "required": true
    },
    "countrySlug": {
      "type": "string",
      "regex": "^[A-Za-z0-9-_.~]+$",
      "required": true
    },
    "slug": {
      "type": "string",
      "regex": "^[A-Za-z0-9-_.~]+$",
      "required": true
    },
    "hero": {
      "type": "component",
      "component": "global.certificate-hero",
      "repeatable": false,
      "required": true
    },
    "overview": {
      "type": "component",
      "component": "global.overview",
      "repeatable": false,
      "required": true
    },
    "scope": {
      "type": "component",
      "component": "global.scope-section",
      "repeatable": false,
      "required": true
    },
    "process": {
      "type": "component",
      "component": "global.process-section",
      "repeatable": false,
      "required": true
    },
    "ourRole": {
      "type": "component",
      "component": "global.role-section",
      "repeatable": false,
      "required": true
    },
    "conclusion": {
      "type": "component",
      "component": "global.conclusion",
      "repeatable": false,
      "required": true
    },
    "finalCta": {
      "type": "component",
      "component": "home.cta-band",
      "repeatable": false,
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "min": 0,
      "required": true
    }
  }
}
