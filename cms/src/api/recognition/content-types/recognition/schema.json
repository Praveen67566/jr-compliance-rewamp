{
  "kind": "collectionType",
  "collectionName": "recognitions",
  "info": {
    "singularName": "recognition",
    "pluralName": "recognitions",
    "displayName": "Recognition",
    "description": "A recognition card selected by the homepage."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "category": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "sourceName": {
      "type": "string"
    },
    "sourceLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "link": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false,
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "min": 0,
      "required": true
    }
  }
}
