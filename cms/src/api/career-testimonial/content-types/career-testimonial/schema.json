{
  "kind": "collectionType",
  "collectionName": "career_testimonials",
  "info": {
    "singularName": "career-testimonial",
    "pluralName": "career-testimonials",
    "displayName": "Career Testimonial",
    "description": "An ordered employee testimonial selected by the Careers page."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "quote": {
      "type": "text",
      "required": true
    },
    "personName": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "sortOrder": {
      "type": "integer",
      "min": 0,
      "required": true
    }
  }
}
