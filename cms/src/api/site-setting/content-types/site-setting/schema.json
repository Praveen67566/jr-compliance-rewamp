{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting",
    "description": "Global content for the shared header, footer, and consultation form."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "headerLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "footerLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "footerBadges": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "headerMenu": {
      "type": "component",
      "component": "navigation.menu-item",
      "repeatable": true,
      "required": true
    },
    "loginButtonEnabled": {
      "type": "boolean",
      "default": false
    },
    "loginButtonHref": {
      "type": "string"
    },
    "headerCta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "footerTagline": {
      "type": "text",
      "required": true
    },
    "footerCta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "footerLinkGroups": {
      "type": "component",
      "component": "navigation.link-group",
      "repeatable": true,
      "required": true
    },
    "contact": {
      "type": "component",
      "component": "shared.contact",
      "repeatable": false,
      "required": true
    },
    "legalLinks": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true,
      "required": true
    },
    "legalNotices": {
      "type": "component",
      "component": "shared.legal-notice",
      "repeatable": true
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true,
      "required": true
    },
    "copyrightText": {
      "type": "string",
      "required": true
    },
    "leadForm": {
      "type": "component",
      "component": "shared.lead-form-settings",
      "repeatable": false
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
