      "component": "registration.card-section",
      "repeatable": false
    },
    "advantages": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false
    },
    "process": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false
    },
    "whyChoose": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false
