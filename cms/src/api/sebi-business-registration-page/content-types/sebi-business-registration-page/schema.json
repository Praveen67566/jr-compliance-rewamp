{
  "kind": "collectionType",
  "collectionName": "sebi_business_registration_pages",
  "info": {
    "singularName": "sebi-business-registration-page",
    "pluralName": "sebi-business-registration-pages",
    "displayName": "SEBI Business Registration Page",
