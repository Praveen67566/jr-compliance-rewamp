{
  "kind": "collectionType",
  "collectionName": "bureau_indian_standards_pages",
  "info": {
    "singularName": "bureau-indian-standards-page",
    "pluralName": "bureau-indian-standards-pages",
    "displayName": "Bureau of Indian Standards Page",
    "description": "A fixed, CMS-managed Bureau of Indian Standards detail page."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "menuLabel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "regex": "^[A-Za-z0-9-_.~]+(?:/[A-Za-z0-9-_.~]+)*$",
      "required": true
    },
    "hero": {
      "type": "component",
      "component": "registration.hero",
      "repeatable": false,
      "required": true
    },
    "trustedLogos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand-logo.brand-logo"
    },
    "overview": {
      "type": "component",
      "component": "registration.overview",
      "repeatable": false,
      "required": true
    },
    "challenges": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false,
      "required": true
    },
    "advantages": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false,
      "required": true
    },
    "process": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false,
      "required": true
    },
    "whyChoose": {
      "type": "component",
      "component": "registration.card-section",
      "repeatable": false,
      "required": true
    },
    "extraContent": {
      "type": "component",
      "component": "registration.extra-content-card",
      "repeatable": true
    },
    "youtubeVideos": {
      "type": "component",
      "component": "registration.youtube-video-section",
      "repeatable": false
    },
    "breakdown": {
      "type": "component",
      "component": "registration.breakdown-section",
      "repeatable": false,
      "required": true
    },
    "resultsSection": {
      "type": "component",
      "component": "registration.results-section",
      "repeatable": false
    },
    "tickerCta": {
      "type": "component",
      "component": "home.cta-band",
      "repeatable": false
    },
    "faqs": {
      "type": "component",
      "component": "registration.faq-section",
      "repeatable": false,
      "required": true
    },
    "finalCta": {
      "type": "component",
      "component": "home.cta-band",
      "repeatable": false,
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
