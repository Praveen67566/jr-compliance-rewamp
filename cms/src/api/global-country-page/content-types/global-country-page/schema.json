{
  "kind": "collectionType",
  "collectionName": "global_country_pages",
  "info": {
    "singularName": "global-country-page",
    "pluralName": "global-country-pages",
    "displayName": "Global Country Page",
    "description": "A fixed, CMS-managed Global country landing page."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "menuLabel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "regex": "^[A-Za-z0-9-_.~]+$",
      "required": true
    },
    "hero": {
      "type": "component",
      "component": "global.country-hero",
      "repeatable": false,
      "required": true
    },
    "certificates": {
      "type": "component",
      "component": "global.certificate-listing",
      "repeatable": false,
      "required": true
    },
    "finalCta": {
      "type": "component",
      "component": "home.cta-band",
      "repeatable": false,
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "min": 0,
      "required": true
    }
  }
}
