{
  "kind": "collectionType",
  "collectionName": "legal_pages",
  "info": {
    "singularName": "legal-page",
    "pluralName": "legal-pages",
    "displayName": "Legal Page",
    "description": "One of the three fixed, CMS-managed footer legal pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "regex": "^(privacy-policy|terms-and-conditions|purchase-and-billing)$",
      "required": true
    },
    "eyebrow": {
      "type": "string",
      "required": true
    },
    "introduction": {
      "type": "blocks"
    },
    "sections": {
      "type": "component",
      "component": "shared.legal-notice",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "min": 0,
      "max": 2,
      "required": true
    }
  }
}
