# Copy to .env.local for local work or .env.production.local on a VPS. Leave
# STRAPI_URL unset during the design phase to use the local fallback content.
# Once Strapi is live, use its public server URL (without a trailing slash).
STRAPI_URL=http://localhost:1337

# Keep this server-only. Create an API token in Strapi with read access to the
# published Home, About, Careers, Contact, and Site setting single types.
STRAPI_API_TOKEN=

# Server-only shared HMAC secret for POST /api/revalidate. It must exactly
# match the CMS STRAPI_REVALIDATE_SECRET; never expose it as NEXT_PUBLIC_*.
STRAPI_REVALIDATE_SECRET=

# Server-side public origin. Set it in every deployed environment for absolute
# canonical URLs and the consultation route's strict same-origin allow-list.
SITE_URL=http://localhost:8123

# Server-only receiver base for the centralized consultation form. The Next.js
# route appends only technical, corporate, or global after validating the page.
LEAD_WEBHOOK_BASE_URL=https://webhook.jrcompliance.com
